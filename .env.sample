# ─────────────────────────────────────────────────────────────────────────
#  Office-Automation-Law-bot · environment template
#  Copy to .env (local / docker-compose) and fill in.  .env is git-ignored.
#  On Railway/cloud, set these as the service's Variables instead of a file.
#  You can also fill most of these later from the UI: /admin/settings.html
# ─────────────────────────────────────────────────────────────────────────

# ── Runtime role (which process this instance runs) ──
# webhook = Express server (Meta webhook + operator dashboard/API)
# poller  = background summariser + Drive-link sender
RUN_ROLE=webhook

# ── WhatsApp Business Cloud API (Meta) ──
PERMANENT_WABA_TOKEN=          # long-lived token (send + media download)
WHATSAPP_PHONE_NUMBER_ID=      # e.g. 123456789012345
WHATSAPP_BUSINESS_NUMBER=      # your own WABA number, e.g. 972797290682
WHATSAPP_VERIFY_TOKEN=         # any secret string; must match Meta webhook config
WHATSAPP_APP_SECRET=           # Meta App secret → enables X-Hub-Signature-256 (recommended)
GRAPH_VERSION=v23.0
# GRAPH_BASE=https://graph.facebook.com   # override only for testing

# ── OpenAI ──
OPENAI_API_KEY=                # sk-...
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini
# OPENAI_BASE=https://api.openai.com       # override only for testing

# ── Google Workspace (Drive + Sheets) ──
SHEETS_ID=                     # Google Sheet id of the Clients registry
SHEET_NAME=Clients
DRIVE_ROOT_ID=                 # parent Drive folder for client cases
DRIVE_MODE=                    # empty (My Drive) or "shared" (Shared Drive)
#
# Google OAuth credentials — TWO ways to provide them:
#   (A) Local / docker-compose: place files at the project root:
#         client_secret.json   (from Google Cloud · OAuth client · Desktop app)
#         token.json           (generate once: `node src/token.js`)
#   (B) Cloud (Railway/Fly/Render): paste the file CONTENTS into these env vars
#       (raw JSON on one line, OR base64). The app prefers env over files.
# GOOGLE_CLIENT_SECRET_JSON=
# GOOGLE_TOKEN_JSON=

# ── Redis ──
# Cloud: set a single REDIS_URL (Railway/Upstash give you one) and skip the rest.
# REDIS_URL=redis://default:password@host:6379
# Local / docker-compose: discrete fields instead of a URL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=                    # set a strong password in production
REDIS_NS=prod                  # key namespace to isolate staging/prod

# ── App / Dashboard ──
# PORT — leave UNSET on Railway/cloud (the platform injects it). Default 8197 locally.
PORT=8197
ADMIN_USER=admin               # HTTP Basic user for /admin (set both → dashboard is protected)
ADMIN_PASS=                    # HTTP Basic password — REQUIRED in production
DEBUG_LEVEL=2                  # 0=silent 1=errors 2=info 3=debug
LOG_TZ=Asia/Jerusalem
MAX_TOOL_TURNS=8
HISTORY_WINDOW=40

# ── ngrok sidecar (docker-compose only — NOT needed on Railway/cloud) ──
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
# NGROK_REGION=eu
